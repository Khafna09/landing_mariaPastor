---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";

interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<Layout title={`${title} | María Pastor`} description={intro ?? title}>
  <Navbar />
  <section class="min-h-screen bg-[#fbfaf6] pt-32 pb-20">
    <div class="max-w-3xl mx-auto px-6">
      <a href="/" class="text-sm font-semibold text-[#168878]">← Volver al inicio</a>
      <p class="mt-10 text-xs font-bold uppercase tracking-[0.24em] text-[#168878]">María Pastor</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-serif font-bold text-[#173f50]">{title}</h1>
      {intro && <p class="mt-5 text-lg leading-relaxed text-[#64777c]">{intro}</p>}
      <div class="legal-content mt-12 space-y-8 text-[#415b63] leading-relaxed">
        <slot />
      </div>
    </div>
  </section>
</Layout>
---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";

interface Props {
  sede: string;
  address: string;
  hours: string;
  mapEmbed: string;
  mapUrl: string;
}

const { sede, address, hours, mapEmbed, mapUrl } = Astro.props;
const title = "Cevichería en " + sede + " | María Pastor";
const description = "Visita María Pastor en " + sede + ". " + address + ". Horario: " + hours + ".";
---

<Layout title={title} description={description}>
  <Navbar />
  <section class="min-h-screen bg-[#fbfaf6] pt-32 pb-20">
    <div class="max-w-5xl mx-auto px-6">
      <a href="/#ubicanos" class="text-sm font-semibold text-[#168878]">← Ver todos los locales</a>
      <div class="mt-10 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-[#168878]">María Pastor</p>
          <h1 class="mt-3 text-4xl md:text-5xl font-serif font-bold text-[#173f50]">Cevichería en {sede}</h1>
          <dl class="mt-8 space-y-6 border-y border-[#173f50]/10 py-7">
            <div>
              <dt class="text-xs font-bold uppercase tracking-[0.18em] text-[#168878]">Dirección</dt>
              <dd class="mt-2 text-lg text-[#415b63]">{address}</dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase tracking-[0.18em] text-[#168878]">Horario</dt>
              <dd class="mt-2 text-lg text-[#415b63]">{hours}</dd>
            </div>
          </dl>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/carta" class="rounded-full bg-[#168878] px-6 py-3 text-xs font-bold uppercase tracking-wider text-white">Ver carta</a>
            <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#173f50]/20 px-6 py-3 text-xs font-bold uppercase tracking-wider text-[#173f50]">Cómo llegar</a>
          </div>
        </div>
        <iframe src={mapEmbed} title={"Mapa de María Pastor " + sede} loading="lazy" class="h-[360px] w-full border border-[#173f50]/10 bg-[#eaf5f4]" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Layout>
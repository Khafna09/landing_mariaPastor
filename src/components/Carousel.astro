---
import { Image } from "astro:assets";

// Import the 3 images for the carousel
import cevicheMixto from "../assets/img/ceviche_mixto.png";
import arrozMariscos from "../assets/img/arroz_mariscos.png";
import causaCangrejo from "../assets/img/causa_cangrejo.png";

const slides = [
    {
        src: cevicheMixto,
        alt: "Ceviche Mixto Especial María Pastor"
    },
    {
        src: arrozMariscos,
        alt: "Arroz con Mariscos Premium"
    },
    {
        src: causaCangrejo,
        alt: "Causa de Cangrejo Gourmet"
    }
];
---

<section
    id="experiencia-slider"
    class="relative w-full h-[60vh] sm:h-[70vh] md:h-[80vh] overflow-hidden bg-slate-950 reveal reveal-fade reveal-duration-1200"
>
    <!-- Slides -->
    <div class="relative w-full h-full">
        {slides.map((slide, index) => (
            <div
                class={`carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
                    index === 0 ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none"
                }`}
                data-index={index}
            >
                <Image
                    src={slide.src}
                    alt={slide.alt}
                    class="w-full h-full object-cover"
                    quality="high"
                    format="webp"
                    loading="lazy"
                />
                <!-- Subtle overlay for visual depth -->
                <div class="absolute inset-0 bg-black/10"></div>
            </div>
        ))}
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3">
        {slides.map((_, index) => (
            <button
                class={`carousel-dot w-3 h-3 rounded-full border border-white/20 transition-all duration-300 focus:outline-none cursor-pointer ${
                    index === 0 ? "bg-[#27b29d] w-6" : "bg-white/30 hover:bg-white/50"
                }`}
                data-index={index}
                aria-label={`Ir a foto ${index + 1}`}
            ></button>
        ))}
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slides = document.querySelectorAll(".carousel-slide");
        const dots = document.querySelectorAll(".carousel-dot");
        if (slides.length === 0) return;

        let currentIndex = 0;
        let intervalId: number;

        const showSlide = (index: number) => {
            slides.forEach((slide, idx) => {
                slide.classList.remove("opacity-100", "pointer-events-auto");
                slide.classList.add("opacity-0", "pointer-events-none");
                
                if (dots[idx]) {
                    dots[idx].classList.remove("bg-[#27b29d]", "w-6");
                    dots[idx].classList.add("bg-white/30");
                }
            });

            slides[index].classList.remove("opacity-0", "pointer-events-none");
            slides[index].classList.add("opacity-100", "pointer-events-auto");
            
            if (dots[index]) {
                dots[index].classList.remove("bg-white/30");
                dots[index].classList.add("bg-[#27b29d]", "w-6");
            }
            
            currentIndex = index;
        };

        const nextSlide = () => {
            let nextIndex = (currentIndex + 1) % slides.length;
            showSlide(nextIndex);
        };

        const startAutoPlay = () => {
            intervalId = window.setInterval(nextSlide, 4000);
        };

        const stopAutoPlay = () => {
            if (intervalId) {
                window.clearInterval(intervalId);
            }
        };

        // Initialize autoplay
        startAutoPlay();

        // Manual controls on dots click
        dots.forEach((dot, idx) => {
            dot.addEventListener("click", () => {
                stopAutoPlay();
                showSlide(idx);
                startAutoPlay();
            });
        });

        const sliderWrapper = document.getElementById("experiencia-slider");
        if (sliderWrapper) {
            sliderWrapper.addEventListener("mouseenter", stopAutoPlay);
            sliderWrapper.addEventListener("mouseleave", startAutoPlay);
        }
    });
</script>

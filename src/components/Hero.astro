---
import { Image } from "astro:assets";
import heroBg from "../assets/img/hero.png";
import logo from "../assets/img/logo.png";
import rappiLogo from "../assets/img/brand/rappi.png";
---

<div
    id="inicio"
    class="relative min-h-screen w-full flex flex-col items-center justify-center overflow-hidden bg-slate-950 font-sans pt-24"
>
    <div class="absolute inset-0 z-0">
        <Image
            src={heroBg}
            alt="Fondo Marino María Pastor"
            class="w-full h-full object-cover object-center"
            quality={60}
            format="webp"
            loading="eager"
            fetchpriority="high"
        />
    </div>

    <div class="absolute inset-0 bg-black/45 backdrop-brightness-[0.85] z-10">
    </div>

    <div
        class="relative z-20 flex flex-col items-center justify-center px-4 text-center max-w-2xl mx-auto my-auto"
    >
        <h1 class="sr-only">María Pastor - Cevichería de Alta Gama</h1>

        <div class="relative mb-8 reveal reveal-scale-up reveal-duration-1000">
            <div
                class="absolute -inset-2 rounded-full border border-[#27b29d]/30 pointer-events-none"
            >
            </div>

            <div
                class="relative w-52 h-52 md:w-60 md:h-60 rounded-full bg-[#0b171c]/95 border border-[#27b29d]/40 flex items-center justify-center p-0 overflow-hidden shadow-2xl transition-transform duration-700 hover:scale-[1.02] mx-auto"
            >
                <Image
                    src={logo}
                    alt="Logo María Pastor"
                    class="w-300 object-cover rounded-full"
                    quality="high"
                    format="webp"
                    loading="eager"
                />
            </div>
        </div>

        <h2
            class="text-lg md:text-xl font-light tracking-[0.25em] text-white/95 uppercase mb-8 font-mono reveal reveal-up reveal-delay-200 reveal-duration-1000"
        >
            El auténtico sabor <span
                class="text-[#27b29d] font-normal font-serif lowercase italic"
                >del mar</span
            >
        </h2>

        <div
            class="flex flex-col sm:flex-row items-center gap-4 w-full justify-center reveal reveal-up reveal-delay-400 reveal-duration-1000"
        >
            <a
                href="/carta"
                class="w-full sm:w-auto px-10 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest text-white bg-[#168878] font-mono"
            >
                Pide para recoger
            </a>

            <a
                href="https://www.rappi.com.pe/restaurantes/11572-maria-pastor-cevicheria"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest text-[#173f50] bg-white border border-white/70 flex items-center justify-center gap-2 font-mono"
            >
                <span
                    class="h-4.5 w-4.5 bg-current inline-block shrink-0"
                    style={`mask: url(${rappiLogo.src}) no-repeat center/contain; -webkit-mask: url(${rappiLogo.src}) no-repeat center/contain;`}
                    role="img"
                    aria-label="Rappi"></span>
                Pide delivery
            </a>
        </div>
    </div>
</div>

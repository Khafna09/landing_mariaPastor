---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { Image } from "astro:assets";
import { createClient } from "@sanity/client";
import pezVintage from "../assets/img/decoraciones/pez-vintage.png";
import caballitoVintage from "../assets/img/decoraciones/caballito_vintage.png";
import caracolVintage from "../assets/img/decoraciones/caracol_vintage.png";
import caracol2Vintage from "../assets/img/decoraciones/caracol2_vintage.png";
import conchaVintage from "../assets/img/decoraciones/concha_vintage.png";
import estrellaVintage from "../assets/img/decoraciones/estrella_vintage.png";
import pecesVintage from "../assets/img/decoraciones/peces_vintage.png";
import mesaMarinaImg from "../assets/img/mesa_marina.png";
import cevicheHistoriaImg from "../assets/img/ceviche_historia.png";
import heroBgImg from "../assets/img/hero.png";
import logo from "../assets/img/logo.png";

const sanityProjectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
const sanityDataset = import.meta.env.PUBLIC_SANITY_DATASET;
const makeWebhookUrl = import.meta.env.PUBLIC_MAKE_WEBHOOK_URL;
const googleScriptUrl = import.meta.env.PUBLIC_GOOGLE_SCRIPT_URL;

const client = createClient({
  projectId: sanityProjectId,
  dataset: sanityDataset,
  apiVersion: "2024-06-08",
  useCdn: false,
});

const rawCategories = await client.fetch(`
  *[_type == "category"] | order(_createdAt asc) {
    name,
    "id": id.current,
    items[]{
      name,
      description,
      price,
      "imageUrl": image.asset->url 
    }
  }
`);

const menuCategories = rawCategories.map((cat) => ({
  id: cat.id,
  name: cat.name,
  items: cat.items
    ? cat.items.map((item) => ({
        name: item.name,
        description: item.description,
        price: `S/ ${(item.price || 0).toFixed(2)}`,
        imageUrl: item.imageUrl
          ? `${item.imageUrl}?w=400&q=80&auto=format`
          : null,
      }))
    : [],
}));
---

---

<Layout>
  <Navbar />

  <div
    class="relative min-h-screen bg-[#eef6fc] text-[#0d131a] pt-28 pb-24 font-sans"
  >
    <div
      class="absolute inset-0 pointer-events-none z-0 overflow-hidden select-none"
    >
      <div
        class="absolute top-[2%] -right-24 w-[350px] md:w-[500px] opacity-[0.06] mix-blend-multiply rotate-12"
      >
        <Image
          src={caballitoVintage}
          alt="Caballito Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[12%] -left-32 w-[400px] md:w-[600px] opacity-[0.06] mix-blend-multiply -rotate-12"
      >
        <Image
          src={conchaVintage}
          alt="Concha Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[25%] -right-28 w-[350px] md:w-[550px] opacity-[0.06] mix-blend-multiply rotate-[35deg]"
      >
        <Image
          src={estrellaVintage}
          alt="Estrella Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[40%] -left-28 w-[400px] md:w-[600px] opacity-[0.06] mix-blend-multiply scale-x-[-1] rotate-[15deg]"
      >
        <Image
          src={pezVintage}
          alt="Pez Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[56%] -right-24 w-[400px] md:w-[600px] opacity-[0.06] mix-blend-multiply rotate-[110deg]"
      >
        <Image
          src={caracolVintage}
          alt="Caracol Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[72%] -left-32 w-[350px] md:w-[550px] opacity-[0.06] mix-blend-multiply -rotate-[45deg]"
      >
        <Image
          src={caracol2Vintage}
          alt="Caracol Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[84%] -right-20 w-[450px] md:w-[650px] opacity-[0.06] mix-blend-multiply rotate-[25deg]"
      >
        <Image
          src={pecesVintage}
          alt="Peces Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[93%] -left-32 w-[400px] md:w-[600px] opacity-[0.06] mix-blend-multiply rotate-45"
      >
        <Image
          src={conchaVintage}
          alt="Concha Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
      <div
        class="absolute top-[98%] -right-24 w-[350px] md:w-[500px] opacity-[0.06] mix-blend-multiply -rotate-12"
      >
        <Image
          src={caballitoVintage}
          alt="Caballito Vintage"
          class="w-full h-auto object-contain"
          format="webp"
          loading="lazy"
        />
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="mb-10">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white/50 backdrop-blur-sm hover:bg-white/90 text-xs font-bold uppercase tracking-widest text-[#133c55] hover:text-[#27b29d] rounded-full border border-[#27b29d]/10 hover:border-[#27b29d]/30 transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5 group"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-4 h-4 transition-transform group-hover:-translate-x-1"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
          </svg>
          Volver al Inicio
        </a>
      </div>

      <div class="text-center mb-16">
        <span
          class="text-xs font-bold uppercase tracking-[0.45em] text-[#27b29d] mb-3 inline-block font-mono"
          >Nuestra Tradición Marina</span
        >
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold font-serif text-[#133c55] tracking-tight"
        >
          La Carta
        </h1>
        <div
          class="w-24 h-[1px] bg-gradient-to-r from-transparent via-[#d31a20] to-transparent mx-auto mt-4"
        >
        </div>
      </div>

      <div
        class="max-w-3xl mx-auto mb-10 bg-[#133c55]/5 border border-[#133c55]/10 rounded-2xl p-5 flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-4 shadow-sm"
      >
        <div
          class="w-10 h-10 shrink-0 bg-[#133c55]/10 rounded-full flex items-center justify-center text-[#133c55]"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615 3.001 3.001 0 0 0 3.75.615m-7.5 0h16.5m-16.5 0h.01m13.99 0a3.001 3.001 0 0 0 3.75-.615m-3.75.615H8.25m8.25 0a3.001 3.001 0 0 0 3.75.615"
            ></path>
          </svg>
        </div>
        <div class="flex-1">
          <h4
            class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-[#133c55] mb-1.5 font-mono"
          >
            Todos los pedidos realizados serán para recojo en tienda
          </h4>
          <p
            class="text-[11px] sm:text-xs text-gray-600 font-medium leading-relaxed mb-3"
          >
            Puede realizar el pedido y seleccionar el recojo en el local de su
            preferencia. Se le enviará una confirmación de WhatsApp con el link
            de pago donde deberá enviar la constancia de su pago.
          </p>
          <div class="flex justify-center sm:justify-start">
            <a
              href="https://www.rappi.com.pe/restaurantes/11572-maria-pastor-cevicheria"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#133c55]/5 hover:bg-[#133c55]/10 text-[#133c55] hover:text-[#27b29d] text-[10px] font-bold uppercase tracking-wider rounded-lg border border-[#133c55]/10 hover:border-[#27b29d]/20 transition-all duration-300 font-mono"
            >
              PREFIERES DELIVERY?
              <svg
                class="w-3 h-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div
        class="sticky top-20 z-40 bg-[#fcfaf7] border-y border-[#133c55]/10 py-3 mb-10 -mx-6 px-6 sm:mx-0 sm:px-0"
      >
        <div
          class="max-w-7xl mx-auto overflow-hidden relative"
          id="category-nav-container"
        >
          <div
            class="absolute left-0 top-0 bottom-0 w-8 bg-gradient-to-r from-[#fcfaf7] to-transparent z-10 pointer-events-none"
          >
          </div>
          <div
            class="absolute right-0 top-0 bottom-0 w-8 bg-gradient-to-l from-[#fcfaf7] to-transparent z-10 pointer-events-none"
          >
          </div>

          <nav
            class="flex overflow-x-auto elegant-scrollbar gap-2 px-4 snap-x scroll-smooth pb-2"
            id="category-nav"
          >
            {
              menuCategories.map((category) => (
                <a
                  href={`#${category.id}`}
                  class="category-nav-link whitespace-nowrap snap-center shrink-0 flex items-center gap-2 px-5 py-3 bg-[#133c55] text-white text-[11px] font-bold tracking-widest uppercase rounded-sm border border-transparent hover:bg-[#27b29d] transition-all duration-300 font-mono"
                >
                  <span class="text-white/50">*</span>
                  {category.name}
                  <span class="text-white/50">*</span>
                </a>
              ))
            }
          </nav>
        </div>
      </div>

      <div class="w-full">
        <main class="space-y-16 pb-24">
          {
            menuCategories.map((category, catIdx) => (
              <section id={category.id} class="scroll-mt-36 relative">
                <h3 class="text-2xl md:text-3xl font-bold tracking-tight text-black mb-8 border-b-2 border-black/5 pb-4 font-serif normal-case">
                  {category.name}
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                  {category.items.map((item) => (
                    <div class="flex flex-row bg-white rounded-2xl border border-gray-100 shadow-[0_4px_15px_-10px_rgba(0,0,0,0.08)] overflow-hidden transition-all duration-300 hover:shadow-[0_8px_25px_-10px_rgba(0,0,0,0.12)] h-[140px] group">
                      <div class="w-[40%] bg-gray-50 shrink-0 relative overflow-hidden flex items-center justify-center">
                        {item.imageUrl ? (
                          <img
                            src={item.imageUrl}
                            alt={item.name}
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            loading="lazy"
                          />
                        ) : (
                          <svg
                            class="w-8 h-8 text-gray-300"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="1.5"
                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2 2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                            />
                          </svg>
                        )}
                      </div>

                      <div class="w-[60%] p-4 flex flex-col justify-between relative">
                        <div class="pr-2">
                          <h4 class="text-[14px] sm:text-[16px] font-bold font-serif text-black leading-tight mb-1.5 line-clamp-2">
                            {item.name}
                          </h4>
                          {item.description && (
                            <p class="text-[10px] sm:text-[11px] text-gray-500 font-medium leading-snug line-clamp-2 sm:line-clamp-3">
                              {item.description}
                            </p>
                          )}
                        </div>

                        <div class="mt-2 flex items-end justify-between">
                          <span class="font-mono font-bold text-[13px] text-black">
                            {item.price}
                          </span>
                        </div>

                        <div
                          class="absolute bottom-3 right-3 interactive-cart-wrapper"
                          data-name={item.name}
                          data-price={item.price.replace("S/ ", "")}
                          data-image={item.imageUrl || ""}
                        >
                          <button class="add-btn-initial w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#133c55] text-white flex items-center justify-center hover:bg-[#27b29d] transition-colors shadow-sm">
                            <svg
                              class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2.5"
                                d="M12 4v16m8-8H4"
                              />
                            </svg>
                          </button>
                          <div class="qty-controls hidden flex items-center bg-[#133c55] rounded-full h-7 sm:h-8 px-1 shadow-md text-white transition-all">
                            <button class="btn-decrease w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center hover:bg-white/20 rounded-full transition-colors" />
                            <span class="qty-display w-4 sm:w-5 text-center text-[10px] sm:text-xs font-bold">
                              1
                            </span>
                            <button class="btn-increase w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center hover:bg-white/20 rounded-full transition-colors">
                              <svg
                                class="w-3 h-3 sm:w-3.5 sm:h-3.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2.5"
                                  d="M12 4v16m8-8H4"
                                />
                              </svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            ))
          }
        </main>
      </div>
    </div>
  </div>

  <div
    id="floating-cart-btn"
    class="fixed bottom-6 right-6 lg:bottom-10 lg:right-10 z-40 transform translate-y-32 transition-transform duration-500"
  >
    <button
      id="open-cart-btn"
      class="bg-[#133c55] hover:bg-[#0f2d40] text-white p-4 rounded-full shadow-[0_10px_30px_-5px_rgba(19,60,85,0.6)] border border-white/10 transition-all duration-300 flex items-center gap-3 group relative overflow-hidden hover:-translate-y-1"
    >
      <div class="relative z-10">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
          ></path>
        </svg>
        <span
          id="cart-badge"
          class="absolute -top-2 -right-2 bg-[#d31a20] text-white shadow-sm text-[10px] font-bold h-5 w-5 rounded-full flex items-center justify-center border border-white/20 font-mono"
          >0</span
        >
      </div>
      <span
        class="font-bold text-xs uppercase tracking-wider hidden sm:block z-10 font-mono"
        >Ver Pedido (S/ <span id="cart-total-floating">0.00</span>)</span
      >
    </button>
  </div>

  <div
    id="cart-overlay"
    class="fixed inset-0 bg-[#0b171c]/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300"
  >
  </div>

  <div
    id="cart-sidebar"
    class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-[#fcfaf7] shadow-[-10px_0_40px_-10px_rgba(0,0,0,0.1)] z-50 transform translate-x-full transition-transform duration-500 flex flex-col border-l border-gray-200"
  >
    <div class="p-6 pb-2 flex justify-between items-center">
      <h2 class="text-[22px] font-bold text-black tracking-tight uppercase">
        Tu Carrito <span id="cart-title-count">(0)</span>
      </h2>
      <button
        id="close-cart-btn"
        class="p-1.5 text-gray-500 hover:text-black border border-gray-300 rounded-lg transition-colors bg-white hover:bg-gray-50"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div
      id="cart-items-container"
      class="flex-1 overflow-y-auto px-6 py-4 space-y-0 divide-y divide-gray-100"
    >
      <div
        id="empty-cart-msg"
        class="h-full flex flex-col items-center justify-center text-center opacity-40 space-y-4 border-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-16 h-16"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
          ></path>
        </svg>
        <p class="font-medium">Tu carrito está vacío</p>
      </div>
    </div>

    <div class="p-6 bg-[#fcfaf7] space-y-5 border-t border-gray-100">
      <div class="flex justify-between items-end font-bold text-black">
        <span class="text-[17px]">Subtotal</span>
        <span class="text-[17px] font-mono"
          >S/ <span id="cart-total-sidebar">0.00</span></span
        >
      </div>
      <button
        id="open-checkout-modal-btn"
        class="w-full bg-[#133c55] hover:bg-[#0f2d40] text-white font-bold uppercase tracking-wider py-3.5 rounded-xl transition-all shadow-sm hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed text-xs font-mono"
      >
        Ingresa tus datos o selecciona un local
      </button>
    </div>
  </div>

  <div
    id="checkout-modal-overlay"
    class="fixed inset-0 bg-[#0b171c]/80 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4 transition-opacity duration-300 opacity-0"
  >
    <div
      id="checkout-modal"
      class="bg-white rounded-[2rem] w-full max-w-md shadow-2xl transform scale-95 transition-transform duration-300 overflow-hidden"
    >
      <div
        class="p-6 pb-4 flex justify-between items-center bg-[#fcfaf7] border-b border-black/5"
      >
        <h3 class="text-2xl font-serif font-bold text-[#133c55]">Tus Datos</h3>
        <button
          id="close-checkout-modal"
          class="text-gray-400 hover:text-black transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-6 h-6"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
      </div>

      <form id="checkout-form" class="p-6 space-y-5">
        <div>
          <label
            class="block text-[11px] font-bold uppercase tracking-widest text-gray-500 mb-2 font-mono"
            >Nombre y Apellido</label
          >
          <input
            type="text"
            id="cliente-nombre"
            required
            minlength="3"
            maxlength="50"
            pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$"
            title="Ingresa tu nombre y apellido (solo letras y espacios, mínimo 3 caracteres)"
            class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-[#27b29d] focus:ring-1 focus:ring-[#27b29d] outline-none transition-all text-black font-medium"
            placeholder="Ej. Juan Pérez"
          />
        </div>

        <div>
          <label
            class="block text-[11px] font-bold uppercase tracking-widest text-gray-500 mb-2 font-mono"
            >Número de Celular</label
          >
          <input
            type="tel"
            id="cliente-celular"
            required
            pattern="9[0-9]{8}"
            title="El celular debe empezar con 9 y tener exactamente 9 dígitos (ej: 999888777)"
            class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-[#27b29d] focus:ring-1 focus:ring-[#27b29d] outline-none transition-all text-black font-medium font-mono"
            placeholder="999888777"
          />
        </div>

        <div>
          <label
            class="block text-[11px] font-bold uppercase tracking-widest text-gray-500 mb-2 font-mono"
            >Local de Recojo</label
          >
          <select
            id="cliente-sede"
            required
            class="w-full px-4 py-3.5 rounded-xl border border-gray-200 focus:border-[#27b29d] focus:ring-1 focus:ring-[#27b29d] outline-none transition-all text-black font-bold bg-white cursor-pointer appearance-none font-mono"
          >
            <option value="" disabled selected>Selecciona una sede...</option>
            <option value="Jesus Maria">Sede Jesús María</option>
            <option value="San Isidro">Sede San Isidro</option>
            <option value="Surquillo">Sede Surquillo</option>
          </select>
        </div>

        <button
          type="submit"
          id="submit-order-btn"
          class="w-full mt-2 bg-[#133c55] hover:bg-[#0f2d40] text-white font-bold uppercase tracking-widest text-[13px] py-4 rounded-xl transition-all shadow-sm hover:shadow-md flex justify-center items-center gap-2 font-mono"
        >
          Enviar Orden a Cocina
        </button>
      </form>
    </div>
  </div>

  <div
    id="success-overlay"
    class="fixed inset-0 bg-[#0b171c]/90 backdrop-blur-md z-[70] hidden flex items-center justify-center p-4 transition-opacity duration-500 opacity-0"
  >
    <div
      id="success-modal"
      class="bg-[#fcfaf7] rounded-[2rem] w-full max-w-md shadow-2xl p-8 flex flex-col items-center justify-center text-center transform scale-95 transition-transform duration-500 border border-white/10"
    >
      <div
        class="relative w-32 h-32 rounded-full bg-[#0b171c]/95 border border-[#27b29d]/40 flex items-center justify-center p-0 overflow-hidden shadow-2xl mb-6"
      >
        <Image
          src={logo}
          alt="Logo María Pastor"
          class="w-[105%] object-cover rounded-full"
          format="webp"
          loading="lazy"
        />
      </div>

      <div
        class="w-9 h-9 bg-[#27b29d]/10 border border-[#27b29d]/30 rounded-full flex items-center justify-center mb-5 text-[#27b29d] animate-bounce"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h3 class="text-2xl font-serif font-bold text-[#133c55] mb-3">
        ¡Orden Recibida!
      </h3>

      <p class="text-sm text-gray-600 font-medium leading-relaxed mb-6 px-4">
        Estamos verificando la disponibilidad en la cocina de <span
          id="success-sede"
          class="font-bold text-[#d31a20]"></span>.<br class="mb-2" />Te
        enviaremos la confirmación y el link de pago por WhatsApp en los
        próximos 2 minutos.
      </p>

      <button
        id="close-success-btn"
        class="w-full bg-[#133c55] hover:bg-[#0f2d40] text-white font-bold uppercase tracking-widest text-[12px] py-4 rounded-xl transition-all shadow-sm hover:shadow-md font-mono"
      >
        Entendido
      </button>
    </div>
  </div>
</Layout>

<script define:vars={{ makeWebhookUrl, googleScriptUrl }} is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Scrollspy Logic
    const sections = document.querySelectorAll("main > section");
    const navLinks = document.querySelectorAll(".category-nav-link");

    const changeActiveLink = () => {
      let index = sections.length;
      while (--index && window.scrollY + 150 < sections[index].offsetTop) {}
      navLinks.forEach((link) => {
        link.classList.remove(
          "text-[#27b29d]",
          "bg-[#27b29d]/5",
          "border-[#27b29d]",
          "font-semibold",
        );
        link.classList.add("text-[#0d131a]/40", "border-transparent");
      });
      if (navLinks[index]) {
        navLinks[index].classList.remove(
          "text-[#0d131a]/40",
          "border-transparent",
        );
        navLinks[index].classList.add(
          "text-[#27b29d]",
          "bg-[#27b29d]/5",
          "border-[#27b29d]",
          "font-semibold",
        );
      }
    };
    changeActiveLink();
    window.addEventListener("scroll", changeActiveLink);

    // ==========================================
    // LÓGICA E-COMMERCE Y CONFIGURACIÓN DE WEBHOOK
    // ==========================================

    // [CONFIGURACIÓN] Elige el destino del webhook descomentando la opción deseada:

    // --- OPCIÓN A: MAKE (ACTUAL) ---
    // const WEBHOOK_URL = makeWebhookUrl;
    // const IS_GOOGLE_SCRIPT = false;

    // --- OPCIÓN B: GOOGLE APPS SCRIPT (FUTURO) ---
    const WEBHOOK_URL = googleScriptUrl;
    const IS_GOOGLE_SCRIPT = true;

    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem("maria_pastor_cart")) || [];
      if (!Array.isArray(cart)) cart = [];
    } catch (e) {
      cart = [];
    }

    const cartOverlay = document.getElementById("cart-overlay");
    const cartSidebar = document.getElementById("cart-sidebar");
    const floatingBtn = document.getElementById("floating-cart-btn");
    const floatingBtnInner = document.getElementById("open-cart-btn");
    const itemsContainer = document.getElementById("cart-items-container");
    const emptyMsg = document.getElementById("empty-cart-msg");
    const openCheckoutBtn = document.getElementById("open-checkout-modal-btn");

    // Modal Elements
    const checkoutModalOverlay = document.getElementById(
      "checkout-modal-overlay",
    );
    const checkoutModal = document.getElementById("checkout-modal");
    const closeCheckoutBtn = document.getElementById("close-checkout-modal");
    const checkoutForm = document.getElementById("checkout-form");
    const submitOrderBtn = document.getElementById("submit-order-btn");

    const playCartAnimation = () => {
      floatingBtnInner.classList.add("animate-cart-bump");
      floatingBtnInner.classList.replace("bg-[#133c55]", "bg-green-600");
      setTimeout(() => {
        floatingBtnInner.classList.remove("animate-cart-bump");
        floatingBtnInner.classList.replace("bg-green-600", "bg-[#133c55]");
      }, 400);
    };

    const syncLocalControls = () => {
      document
        .querySelectorAll(".interactive-cart-wrapper")
        .forEach((wrapper) => {
          const name = wrapper.dataset.name;
          const price = parseFloat(wrapper.dataset.price);
          const image = wrapper.dataset.image;

          const initialBtn = wrapper.querySelector(".add-btn-initial");
          const qtyControls = wrapper.querySelector(".qty-controls");
          const btnDecrease = wrapper.querySelector(".btn-decrease");
          const btnIncrease = wrapper.querySelector(".btn-increase");
          const qtyDisplay = wrapper.querySelector(".qty-display");

          const cartItem = cart.find((item) => item.name === name);

          if (!cartItem) {
            initialBtn.classList.remove("hidden");
            qtyControls.classList.add("hidden");
            qtyControls.classList.remove("flex");

            initialBtn.onclick = () => {
              cart.push({ name, price, quantity: 1, image });
              updateCartUI();
              playCartAnimation();
            };
          } else {
            initialBtn.classList.add("hidden");
            qtyControls.classList.remove("hidden");
            qtyControls.classList.add("flex");

            qtyDisplay.innerText = cartItem.quantity;

            if (cartItem.quantity === 1) {
              btnDecrease.innerHTML = `<svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white hover:text-red-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>`;
            } else {
              btnDecrease.innerHTML = `<svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M20 12H4"/></svg>`;
            }

            btnDecrease.onclick = () => {
              if (cartItem.quantity === 1) {
                cart = cart.filter((i) => i.name !== name);
              } else {
                cartItem.quantity--;
              }
              updateCartUI();
            };

            btnIncrease.onclick = () => {
              cartItem.quantity++;
              updateCartUI();
            };
          }
        });
    };

    const updateCartUI = () => {
      const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
      const totalPrice = cart
        .reduce((sum, item) => sum + item.price * item.quantity, 0)
        .toFixed(2);

      document.getElementById("cart-badge").innerText = totalItems;
      document.getElementById("cart-total-floating").innerText = totalPrice;
      document.getElementById("cart-total-sidebar").innerText = totalPrice;
      document.getElementById("cart-title-count").innerText = `(${totalItems})`;

      if (totalItems > 0) {
        floatingBtn.classList.remove("translate-y-32");
      } else {
        floatingBtn.classList.add("translate-y-32");
      }

      renderCartItems();
      syncLocalControls();
      localStorage.setItem("maria_pastor_cart", JSON.stringify(cart));
    };

    const renderCartItems = () => {
      if (cart.length === 0) {
        itemsContainer.innerHTML = "";
        itemsContainer.appendChild(emptyMsg);
        emptyMsg.classList.remove("hidden");
        openCheckoutBtn.disabled = true;
        return;
      }

      emptyMsg.classList.add("hidden");
      openCheckoutBtn.disabled = false;
      itemsContainer.innerHTML = "";

      cart.forEach((item, index) => {
        const div = document.createElement("div");
        div.className =
          "w-full bg-transparent group border-b border-gray-100 last:border-0";
        const isDefaultLogo = !item.image;
        const itemImage = item.image || "/src/assets/img/logo.png";
        const bgClass = isDefaultLogo ? "bg-[#0b171c] p-2" : "bg-gray-100";
        const imgFitClass = isDefaultLogo ? "object-contain" : "object-cover";

        div.innerHTML = `
          <div class="py-5 flex gap-4 w-full relative">
            <div class="w-16 h-16 shrink-0 ${bgClass} rounded-xl overflow-hidden border border-black/5 flex items-center justify-center">
              <img src="${itemImage}" class="w-full h-full ${imgFitClass}" alt="${item.name}" />
            </div>
            
            <div class="flex-1 flex flex-col justify-between pt-1">
              <div class="flex justify-between items-start gap-2 mb-2">
                <h5 class="font-serif font-bold text-black text-[13px] leading-tight pr-4">${item.name}</h5>
                <p class="font-mono text-black font-bold text-[13px] whitespace-nowrap">S/ ${(item.price * item.quantity).toFixed(2)}</p>
              </div>
              
              <div class="flex justify-between items-center w-full">
                <div class="flex items-center gap-4 bg-gray-50/50 rounded-full px-3 py-1.5 border border-black/5">
                  <button class="cart-qty-minus flex items-center justify-center text-gray-500 hover:text-red-500 transition-colors" data-index="${index}">
                    ${
                      item.quantity === 1
                        ? '<svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>'
                        : '<svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4"/></svg>'
                    }
                  </button>
                  <span class="text-xs font-bold w-4 text-center text-black pointer-events-none">${item.quantity}</span>
                  <button class="cart-qty-plus flex items-center justify-center text-gray-500 hover:text-[#27b29d] transition-colors" data-index="${index}">
                    <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                  </button>
                </div>
                
              </div>
            </div>
          </div>
        `;
        itemsContainer.appendChild(div);
      });

      document.querySelectorAll(".cart-qty-plus").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          cart[e.target.dataset.index].quantity++;
          updateCartUI();
        });
      });

      document.querySelectorAll(".cart-qty-minus").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const index = e.target.dataset.index;
          if (cart[index].quantity > 1) {
            cart[index].quantity--;
          } else {
            cart.splice(index, 1);
          }
          updateCartUI();
        });
      });
    };

    const toggleCart = () => {
      cartSidebar.classList.toggle("translate-x-full");
      cartOverlay.classList.toggle("hidden");
      setTimeout(() => cartOverlay.classList.toggle("opacity-0"), 10);
    };

    const toggleCheckoutModal = () => {
      if (checkoutModalOverlay.classList.contains("hidden")) {
        checkoutModalOverlay.classList.remove("hidden");
        setTimeout(() => {
          checkoutModalOverlay.classList.remove("opacity-0");
          checkoutModal.classList.remove("scale-95");
        }, 10);
      } else {
        checkoutModalOverlay.classList.add("opacity-0");
        checkoutModal.classList.add("scale-95");
        setTimeout(() => checkoutModalOverlay.classList.add("hidden"), 300);
      }
    };

    document
      .getElementById("open-cart-btn")
      .addEventListener("click", toggleCart);
    document
      .getElementById("close-cart-btn")
      .addEventListener("click", toggleCart);
    cartOverlay.addEventListener("click", toggleCart);

    openCheckoutBtn.addEventListener("click", () => {
      toggleCart(); // Cierra el sidebar
      setTimeout(toggleCheckoutModal, 300); // Abre el modal
    });

    closeCheckoutBtn.addEventListener("click", toggleCheckoutModal);
    checkoutModalOverlay.addEventListener("click", (e) => {
      if (e.target === checkoutModalOverlay) toggleCheckoutModal();
    });

    // ==========================================
    // ENVÍO DE DATOS A MAKE
    // ==========================================
    checkoutForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (cart.length === 0) {
        alert("El Carrito está vacío.");
        return;
      }

      const nombre = document.getElementById("cliente-nombre").value;
      const celular = document.getElementById("cliente-celular").value;
      const sede = document.getElementById("cliente-sede").value;

      const idAleatorio = Math.floor(Math.random() * 9000) + 1000;

      const payload = {
        id_pedido: `PED-${idAleatorio}`,
        cliente: nombre,
        celular: celular,
        sede: sede,
        items: cart.map(item => ({ name: item.name, quantity: item.quantity }))
      };

      submitOrderBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        Procesando...
      `;
      submitOrderBtn.disabled = true;

      try {
        if (
          !WEBHOOK_URL ||
          WEBHOOK_URL.includes("TU_NUEVA_URL_AQUI") ||
          WEBHOOK_URL.includes("PEGAR_AQUI")
        ) {
          alert("¡Atención! Falta configurar la URL del Webhook.");
          submitOrderBtn.innerHTML = "Enviar Orden a Cocina";
          submitOrderBtn.disabled = false;
          return;
        }

        let envioExitoso = false;

        if (IS_GOOGLE_SCRIPT) {
          const response = await fetch(WEBHOOK_URL, {
            method: "POST",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify(payload),
          });
          const responseData = await response.json();
          if (responseData.status === "success") {
            envioExitoso = true;
          }
        } else {
          const response = await fetch(WEBHOOK_URL, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (response.ok) {
            envioExitoso = true;
          }
        }

        if (envioExitoso) {
          cart = [];
          updateCartUI();
          toggleCheckoutModal();

          submitOrderBtn.innerHTML = "Enviar Orden a Cocina";
          submitOrderBtn.disabled = false;
          checkoutForm.reset();

          const successOverlay = document.getElementById("success-overlay");
          const successModal = document.getElementById("success-modal");
          document.getElementById("success-sede").innerText = sede;

          successOverlay.classList.remove("hidden");
          setTimeout(() => {
            successOverlay.classList.remove("opacity-0");
            successModal.classList.remove("scale-95");
          }, 50);

          const closeSuccessBtn = document.getElementById("close-success-btn");
          closeSuccessBtn.onclick = () => {
            successOverlay.classList.add("opacity-0");
            successModal.classList.add("scale-95");
            setTimeout(() => {
              successOverlay.classList.add("hidden");
              window.scrollTo(0, 0);
            }, 300);
          };
        } else {
          throw new Error("Fallo en la red");
        }
      } catch (error) {
        console.error("Error en el envío:", error);
        alert("Hubo un problema de conexión. Intenta nuevamente.");
        submitOrderBtn.innerHTML = "Enviar Orden a Cocina";
        submitOrderBtn.disabled = false;
      }
    });

    updateCartUI();
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .elegant-scrollbar::-webkit-scrollbar {
    height: 4px;
  }
  .elegant-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .elegant-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(19, 60, 85, 0.2);
    border-radius: 10px;
  }
  .elegant-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(19, 60, 85, 0.4);
  }
  .elegant-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(19, 60, 85, 0.2) transparent;
  }

  @keyframes cartBump {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.15) translateY(-4px);
    }
    100% {
      transform: scale(1);
    }
  }
  .animate-cart-bump {
    animation: cartBump 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
</style>

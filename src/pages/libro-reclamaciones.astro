---
import LegalLayout from "../components/LegalLayout.astro";
---

<LegalLayout title="Libro de Reclamaciones" intro="Formulario de demostración para registrar una queja o reclamo.">
  <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"><strong>Modo demostración.</strong> Este formulario no envía ni registra información. Antes de publicarse se conectará a un Google Apps Script separado que generará, archivará y enviará la hoja en PDF.</div>
  <form class="mt-8 space-y-5 rounded-2xl border border-[#173f50]/10 bg-white p-6">
    <div class="grid gap-5 sm:grid-cols-2">
      <label class="text-sm font-medium">Nombre completo<input disabled placeholder="Datos de demostración" class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-3 disabled:bg-slate-50" /></label>
      <label class="text-sm font-medium">Documento de identidad<input disabled placeholder="Datos de demostración" class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-3 disabled:bg-slate-50" /></label>
    </div>
    <label class="block text-sm font-medium">Detalle del reclamo o queja<textarea disabled rows="5" placeholder="Formulario demostrativo" class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-3 disabled:bg-slate-50"></textarea></label>
    <button disabled class="rounded-full bg-[#173f50] px-6 py-3 text-sm font-semibold text-white opacity-50">Enviar reclamo (demostración)</button>
  </form>
</LegalLayout>
